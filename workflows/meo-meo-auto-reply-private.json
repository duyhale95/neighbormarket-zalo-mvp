{
  "_deplaoWorkflow": true,
  "_version": 1,
  "channel": "zalo",
  "name": "Meo Meo - Gemini - Auto Reply Private",
  "description": "Tra loi moi tin nhan van ban trong chat rieng, khong can /chat. Bo qua tin tu gui va tin nhom. Sau import chon tai khoan Meo Meo, kiem tra tro ly Gemini va bat workflow. Khong doi ten GeminiReply.",
  "nodes": [
    {
      "id": "receive",
      "type": "trigger.message",
      "label": "ReceivePrivateMessage",
      "position": {
        "x": 320,
        "y": 70
      },
      "config": {
        "threadType": "0",
        "fromId": "",
        "senderRole": "all",
        "ignoreOwn": true,
        "onlyOwn": false,
        "keyword": "",
        "keywordMode": "starts_with",
        "messageTypes": [
          "text"
        ],
        "debounceSeconds": 0
      }
    },
    {
      "id": "generate",
      "type": "ai.generateText",
      "label": "GeminiReply",
      "position": {
        "x": 320,
        "y": 270
      },
      "config": {
        "aiConfigMode": "assistant",
        "assistantId": "",
        "prompt": "Tin nhắn người dùng: {{ $trigger.content }}\nHãy trả lời thân thiện, tự nhiên bằng tiếng Việt theo System Prompt của trợ lý. Không yêu cầu người dùng nhập /chat hay AI:. Không tuyên bố đã lưu, đăng hoặc duyệt tin nếu chưa có công cụ thực hiện.",
        "maxHistoryMessages": 10
      }
    },
    {
      "id": "typing",
      "type": "zalo.sendTyping",
      "label": "DangGo",
      "position": {
        "x": 320,
        "y": 460
      },
      "config": {
        "threadId": "{{ $trigger.threadId }}",
        "threadType": "0",
        "delaySeconds": 1
      }
    },
    {
      "id": "send",
      "type": "zalo.sendMessage",
      "label": "SendToSamePrivateChat",
      "position": {
        "x": 320,
        "y": 650
      },
      "config": {
        "threadId": "{{ $trigger.threadId }}",
        "threadType": "0",
        "message": "{{ $node.GeminiReply.output }}",
        "sendDelayMinSeconds": 1,
        "sendDelayMaxSeconds": 2
      }
    }
  ],
  "edges": [
    {
      "id": "edge1",
      "source": "receive",
      "sourceHandle": "default",
      "target": "generate"
    },
    {
      "id": "edge2",
      "source": "generate",
      "sourceHandle": "default",
      "target": "typing"
    },
    {
      "id": "edge3",
      "source": "typing",
      "sourceHandle": "default",
      "target": "send"
    }
  ]
}
