# Example only. Values are not loaded automatically; set them in the process environment.
# Never commit real credentials or private configuration.
BRIDGE_API_KEY=replace-with-a-random-bridge-secret
ADMIN_API_KEY=replace-with-a-different-admin-secret
DATABASE_PATH=private/market.db
ZALO_COMMUNITY_ID=demo
ZALO_LEGIT_GROUP_ID=
# Optional trusted intake adapter; intake key must differ from bridge key.
BACKEND_URL=http://127.0.0.1:8000
INTAKE_API_KEY=replace-with-a-different-intake-secret
COMMUNITY_ID=demo
# Deplao personal account only (not a Bot Platform token).
# Prefer private/zalo-channel.json generated after manual policy/group checks.
ZALO_ACCOUNT_ID=
ZALO_TEST_SENDER_IDS=
# Optional OpenAI extraction: disabled unless explicitly enabled and configured.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Group publication: 'single' (default, one text post) or 'photos_v2'
# (cover photo + extra photos + code, then sold notice). Applies to NEW approvals only.
ZALO_PUBLICATION_MODE=single
# Optional image moderation (server only). Disabled => every image is 'unavailable'
# and BQL must record manual evidence. Never treated as 'clear'.
IMAGE_MODERATION_ENABLED=false
IMAGE_MODERATION_API_KEY=
IMAGE_MODERATION_MODEL=omni-moderation-latest
# Zalo photo intake stays off unless ZALO_IMAGES_ENABLED=true AND the private
# manifest (ZALO_CHANNEL_CONFIG, default private/zalo-channel.json) records the
# strict Deplao engine hash plus verified photo metadata. Env alone cannot enable it.
ZALO_IMAGES_ENABLED=false
ZALO_CHANNEL_CONFIG=private/zalo-channel.json
# No Gemini or Bot Platform consumer is enabled by this branch.
