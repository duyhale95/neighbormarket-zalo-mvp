# Example only. Values are not loaded automatically; set them in the process environment.
# Never commit real credentials or private configuration.
BRIDGE_API_KEY=replace-with-a-random-bridge-secret
ADMIN_API_KEY=replace-with-a-different-admin-secret
DATABASE_PATH=private/market.db
ZALO_COMMUNITY_ID=demo
ZALO_LEGIT_GROUP_ID=
# Optional trusted intake adapter; intake key must differ from bridge key.
BACKEND_URL=http://127.0.0.1:8000
INTAKE_API_KEY=replace-with-a-different-intake-secret
COMMUNITY_ID=demo
# Deplao personal account only (not a Bot Platform token).
# Prefer private/zalo-channel.json generated after manual policy/group checks.
ZALO_ACCOUNT_ID=
ZALO_TEST_SENDER_IDS=
# Optional OpenAI extraction: disabled unless explicitly enabled and configured.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# No Gemini/Bot Platform consumer or image downloader is enabled by this branch.
