# Server only. Copy to .env.local and configure; never add NEXT_PUBLIC_ to these.
BACKEND_URL=http://127.0.0.1:8000
ADMIN_API_KEY=
BQL_DEMO_PASSWORD=
# At least 32 random characters; rotating it invalidates existing sessions.
BQL_SESSION_SECRET=
# Exact frontend origin. Use HTTPS in deployment; it enables Secure cookies.
APP_ORIGIN=http://127.0.0.1:3000
BQL_COMMUNITY_ID=demo
